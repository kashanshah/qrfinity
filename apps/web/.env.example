# Copy to .env.local for local development. Production values go in Vercel's environment settings.

# Postgres (Neon in production; use the pooled connection string).
DATABASE_URL=postgres://qrfinity:qrfinity@localhost:5432/qrfinity

# Better Auth: a long random string (openssl rand -base64 32) and the site's public URL.
BETTER_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional). Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Production: Resend API key and a verified sender. Local: DEV_MAILBOX=1 keeps emails in memory.
RESEND_API_KEY=
EMAIL_FROM="QRfinity <hello@mail.qrfinity.com>"
DEV_MAILBOX=1

# Cloudflare Turnstile. Local development can skip it with TURNSTILE_DISABLED=1 (never in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_DISABLED=1

# The private edge-api Worker that writes KV (local: pnpm dev:workers).
EDGE_API_URL=http://localhost:8788
EDGE_API_SECRET=dev-edge-secret

# Short links. Production: leave SHORT_LINK_ORIGIN empty (https://qrfinity.link). Local: the redirect Worker.
SHORT_DOMAIN=qrfinity.link
SHORT_LINK_ORIGIN=http://localhost:8787

# Scan analytics: analytics-engine (production), postgres (local), or none.
ANALYTICS_BACKEND=postgres
# Production: Cloudflare account id and an API token with "Account Analytics: Read" on the qrfinity.link account.
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
# Local: shared with the redirect Worker's dev scan sink.
SCAN_SINK_SECRET=dev-sink-secret

# Abuse protection. Google Web Risk API key (Google Cloud → Web Risk API → credentials).
# Without it, new destinations are only checked against the blocklist and shortener list.
WEB_RISK_API_KEY=
# Web Risk lookups the daily re-check may spend (the first 100,000 a month are free).
RECHECK_DAILY_BUDGET=3000
# Emails allowed into /admin (comma-separated), and the address in abuse notices.
ADMIN_EMAILS=
ABUSE_EMAIL=abuse@qrfinity.com

# Vercel Cron sends this as a Bearer token to /api/cron/edge-sync and /api/cron/recheck.
CRON_SECRET=dev-cron-secret
# Hashing key for rate-limit identifiers (defaults to BETTER_AUTH_SECRET).
RATE_LIMIT_SECRET=

# Optional partner links (Phase 6). Each is hidden when empty. UTM tags are added automatically.
# Shown after a download: "Print your QR code as stickers or magnets".
NEXT_PUBLIC_PRINT_PARTNER_URL=
# Shown in the footer: "Need a QR campaign or landing page built?".
NEXT_PUBLIC_AGENCY_URL=
