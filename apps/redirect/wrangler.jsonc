// Redirect Worker for qrfinity.link. Deployed to the separate Cloudflare account that owns qrfinity.link.
// Replace the placeholder ids with the real KV namespace and Hyperdrive config before the first deploy.
{
  "name": "qrfinity-redirect",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "qrfinity.link", "custom_domain": true }],
  "workers_dev": false,
  "kv_namespaces": [{ "binding": "LINKS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "analytics_engine_datasets": [{ "binding": "SCANS", "dataset": "qrfinity_scans" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      // Local development: the read-only role against the local database.
      "localConnectionString": "postgres://redirect_reader:redirect_reader@localhost:5432/qrfinity",
    },
  ],
  "ratelimits": [
    { "name": "MISS_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 10 } },
  ],
  "vars": {
    "DEFAULT_DOMAIN": "qrfinity.link",
    "SITE_ORIGIN": "https://qrfinity.com",
  },
  // Off: invocation logs would record request headers, including visitor IPs.
  "observability": { "enabled": false },
}
